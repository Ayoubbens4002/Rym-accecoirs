# URLs relatives : le proxy Vite (vite.config.js) redirige vers Laravel
VITE_API_URL=/api/v1

# Cible du proxy — choisir UNE option :

# Option A : php artisan serve (recommandé pour le dev)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Option B : Apache XAMPP (décommenter et adapter le chemin si vous utilisez Apache)
# VITE_PROXY_TARGET=http://localhost/sr-api/public
